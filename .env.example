# ============================================================
# 로컬 개발용 비밀값 템플릿
#   1) 이 파일을 복사:  cp .env.example .env
#   2) .env 에 실제 키를 입력 (.env 는 gitignore 되어 커밋되지 않음)
#
# docker compose 는 프로젝트 루트의 .env 를 자동으로 읽어 ${VAR} 를 치환하고,
# uvicorn 으로 직접 실행할 때는 backend/config.py 의 load_dotenv 가 읽는다.
#
# Railway 배포 시에는 이 파일을 쓰지 않는다 —
# Railway 대시보드 → 해당 서비스 → Variables 탭에 같은 이름으로 등록하면
# 런타임 환경변수로 주입되어 코드 수정 없이 동일하게 동작한다.
# ============================================================

# LLM API 키 (사용할 프로바이더 것만 채우면 됨)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM 프로바이더/모델 (선택)
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=25   # 프록시(Vercel 등) 뒤에서는 프록시 타임아웃보다 짧게
LLM_MODEL=
AGENT_LLM_INPUT=
AGENT_LLM_ACCOUNT=
AGENT_LLM_SEARCH=
AGENT_LLM_OPTIMIZATION=
AGENT_LLM_EVALUATION=gemini:gemini-3.5-flash

# DB 접속 (Railway 등 외부 배포 시 원격 DB 정보로 교체)
# ETF_DB_HOST=127.0.0.1
# ETF_DB_PORT=3306
# ETF_DB_USER=root
# ETF_DB_PASSWORD=mysql
# ETF_DB_NAME=etf_db
